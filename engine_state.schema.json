{
  "$comment": "engine_state.schema.json \u2014 versioned output contract for the Friday 0DTE timing engine (spec v3 \u00a735). Producers (simulation core, learned layer, heuristic) may change; this contract may only EXTEND (add optional keys), never break. Consumed by the UI card, the decision journal, and backtests. Validated by timing_engine.validate_state() \u2014 a stdlib mini-validator that enforces required/type/enum below (no external jsonschema dependency by house rule).",
  "schema_version": "1.0",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "ts_et",
    "symbol",
    "contract",
    "intent",
    "state",
    "state_raw",
    "reason",
    "score",
    "confidence",
    "layer",
    "blocked",
    "credit",
    "probabilities",
    "wait",
    "risk",
    "model"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "ts_et": {
      "type": "string",
      "$comment": "ISO-8601 America/New_York"
    },
    "symbol": {
      "type": "string"
    },
    "contract": {
      "type": "object",
      "required": [
        "strike",
        "expiry",
        "kind"
      ],
      "properties": {
        "occ": {
          "type": [
            "string",
            "null"
          ]
        },
        "strike": {
          "type": "number"
        },
        "expiry": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "call",
            "put"
          ]
        },
        "contracts": {
          "type": [
            "number",
            "null"
          ],
          "$comment": "intended size for my-dollars display (\u00a717)"
        }
      }
    },
    "intent": {
      "type": "string",
      "enum": [
        "income_only",
        "wheel_acceptable"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "WAIT",
        "GETTING CLOSE",
        "SELL ZONE",
        "STRONG SELL ZONE",
        "TOO LATE",
        "BLOCKED"
      ],
      "$comment": "displayed state AFTER \u00a734 hysteresis"
    },
    "state_raw": {
      "type": "string",
      "$comment": "pre-hysteresis state \u2014 journaled so the cost of hysteresis is measurable"
    },
    "reason": {
      "type": "string",
      "$comment": "the one-line reason (\u00a718)"
    },
    "score": {
      "type": [
        "number",
        "null"
      ],
      "$comment": "0-100 summary (\u00a717); null when BLOCKED"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "$comment": "0-1"
    },
    "layer": {
      "type": "string",
      "enum": [
        "SIMULATION PRIOR",
        "TRAINED",
        "HEURISTIC",
        "MEASURED"
      ],
      "$comment": "which layer produced the primary state (\u00a721 badge)"
    },
    "blocked": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "$comment": "non-null only when state == BLOCKED: stale_quote, bad_spread, invalid_quote, market_closed, expired, clock_drift, event_window, no_data"
    },
    "credit": {
      "type": "object",
      "required": [
        "bid",
        "mid",
        "spread_pct",
        "quote_age_s"
      ],
      "properties": {
        "bid": {
          "type": [
            "number",
            "null"
          ]
        },
        "ask": {
          "type": [
            "number",
            "null"
          ]
        },
        "mid": {
          "type": [
            "number",
            "null"
          ]
        },
        "last": {
          "type": [
            "number",
            "null"
          ]
        },
        "bid_size": {
          "type": [
            "number",
            "null"
          ]
        },
        "ask_size": {
          "type": [
            "number",
            "null"
          ]
        },
        "spread_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "quote_age_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "session": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "raw_high": {},
            "mid_high": {},
            "exec_high": {},
            "durable_high": {},
            "admissible_high": {},
            "premium_percentile": {}
          },
          "$comment": "\u00a72 benchmarks from the tape; null before the tape has today's data"
        }
      }
    },
    "probabilities": {
      "type": "object",
      "required": [
        "p_itm",
        "p_touch",
        "p_itm_analytic",
        "p_touch_analytic",
        "p_better"
      ],
      "properties": {
        "p_itm": {
          "type": [
            "number",
            "null"
          ],
          "$comment": "primary (simulation once shading active; \u00a712)"
        },
        "p_touch": {
          "type": [
            "number",
            "null"
          ]
        },
        "p_itm_analytic": {
          "type": [
            "number",
            "null"
          ],
          "$comment": "unshaded closed-form prior \u2014 stays visible; a large gap vs primary is information"
        },
        "p_touch_analytic": {
          "type": [
            "number",
            "null"
          ]
        },
        "p_better": {
          "type": "object",
          "$comment": "keys h5,h15,h30,h60,close,next_look \u2192 0-1"
        },
        "mc_se": {
          "type": [
            "number",
            "null"
          ],
          "$comment": "Monte Carlo standard error of the probability estimates (Amendment B)"
        }
      }
    },
    "wait": {
      "type": "object",
      "required": [
        "expected_extra_credit",
        "wait_edge"
      ],
      "properties": {
        "expected_extra_credit": {
          "type": [
            "number",
            "null"
          ],
          "$comment": "per contract, to close, admissible"
        },
        "expected_extra_dollars": {
          "type": [
            "number",
            "null"
          ],
          "$comment": "\u00d7 intended contracts \u00d7 100 (\u00a717 my dollars)"
        },
        "expected_extra_next_look": {
          "type": [
            "number",
            "null"
          ]
        },
        "expected_time_to_better_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "wait_edge": {
          "type": [
            "number",
            "null"
          ],
          "$comment": "\u00a79: E[best admissible capturable sale] \u2212 CreditNow, intent-aware"
        },
        "timing_regret_now": {
          "type": [
            "number",
            "null"
          ]
        },
        "decomposition": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "spot": {},
            "gamma": {},
            "theta": {},
            "iv": {},
            "execution": {}
          },
          "$comment": "\u00a710 display-only dV \u2248 \u0394\u00b7dS + \u00bd\u0393\u00b7dS\u00b2 + \u0398\u00b7dt + V\u00b7dIV"
        },
        "scenarios": {
          "type": [
            "array",
            "null"
          ],
          "$comment": "\u00a710 modeled premium rows: unchanged 15m, tags extreme 15/30m, reverses now, IV contracts"
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "admissible"
      ],
      "properties": {
        "admissible": {
          "type": "boolean",
          "$comment": "selling NOW satisfies the intent profile's limits"
        },
        "delta": {
          "type": [
            "number",
            "null"
          ]
        },
        "gamma": {
          "type": [
            "number",
            "null"
          ]
        },
        "theta_per_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "vega": {
          "type": [
            "number",
            "null"
          ]
        },
        "iv": {
          "type": [
            "number",
            "null"
          ]
        },
        "iv_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "backed_out",
            "chain",
            "chain_interp",
            "unusable",
            null
          ]
        },
        "headroom_dollars": {
          "type": [
            "number",
            "null"
          ],
          "$comment": "adverse spot move that fits before a limit breaks"
        },
        "distance": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "dollars": {},
            "pct": {},
            "sigma": {}
          }
        },
        "minutes_remaining": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "limits": {
      "type": [
        "object",
        "null"
      ],
      "$comment": "\u00a714 three resting limits; each: {price, fill_prob, expected_minutes_to_fill, spot_required, delta_if_filled, p_touch_if_filled, p_itm_if_filled, basis}"
    },
    "tranche": {
      "type": [
        "object",
        "null"
      ],
      "$comment": "\u00a713: {suggest_frac, plan, sold_frac, avg_credit_so_far, basis: dynamic|cold_start}"
    },
    "attention": {
      "type": [
        "object",
        "null"
      ],
      "$comment": "\u00a731: {next_look_min, p_better_next_look, alert: null|{rank_dollars, action, reason}}"
    },
    "final_hour": {
      "type": [
        "object",
        "null"
      ],
      "$comment": "\u00a733, active only inside the window: {active, cost_to_close, remaining_credit, risk_per_penny, recommend, exercise_watch}"
    },
    "heuristic": {
      "type": [
        "object",
        "null"
      ],
      "$comment": "v2 cross-check: {score, momentum_gate_m, state, agrees, disagree_hard} \u2014 hard disagreement drops confidence and the UI says so"
    },
    "volatility_edge": {
      "description": "Remaining-session variance edge (Premium Edge integration, schema 1.0 additive optional field): implied vs tape-projected remaining variance, score nudge applied. Null when disabled, early in the session, or tape is unusable.",
      "type": [
        "object",
        "null"
      ]
    },
    "what_changed": {
      "type": [
        "array",
        "null"
      ],
      "$comment": "\u00a719 deltas since this card was last opened/alerted"
    },
    "data_quality": {
      "type": [
        "object",
        "null"
      ],
      "$comment": "\u00a721: {source, stock_quote_age_s, option_quote_age_s, snapshot_age_s, spread_quality, real_vs_modeled, sample_size, calibration}"
    },
    "model": {
      "type": "object",
      "required": [
        "version",
        "config_hash",
        "seed",
        "paths"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "config_hash": {
          "type": "string"
        },
        "seed": {
          "type": "number",
          "$comment": "RNG seed \u2014 replay is byte-identical (Amendment B)"
        },
        "paths": {
          "type": "number"
        },
        "snapshot_ids": {
          "type": [
            "array",
            "null"
          ]
        },
        "inputs": {
          "type": [
            "object",
            "null"
          ],
          "$comment": "full input snapshot for \u00a735 replay"
        }
      }
    }
  }
}
